{
  "manifest_version": 1,
  "version": 1,
  "type": "APP",
  "name": {
    "ja": "メンテナンス管理プラグイン",
    "en": "Maintenance Management Plugin"
  },
  "description": {
    "ja": "アプリにメンテナンス画面を表示し、ユーザーのアクセスを一時的にブロックするプラグインです。",
    "en": "Displays a maintenance screen and temporarily blocks user access to the app."
  },
  "icon": "image/icon.png",
  "desktop": {
    "js": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.js",
      "js/manager.js",
      "js/desktop.js"
    ],
    "css": []
  },
  "mobile": {
    "js": [
      "js/desktop.js"
    ]
  },
  "config": {
    "html": "html/config.html",
    "js": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.js",
      "js/config.js"
    ],
    "css": [
      "css/config.css"
    ],
    "required_params": [
      "operationMode"
    ]
  }
}
